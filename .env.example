# Live workshop. Set one live provider and keep its key only in .env.
# Ollama and OpenAI are switchable at runtime from the app's Settings dialog.
AGENTFORGE_PROVIDER=openai
AGENTFORGE_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Alternative: local Ollama (no key needed; run `ollama serve` first).
# AGENTFORGE_PROVIDER=ollama
# AGENTFORGE_MODEL=llama3.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local app defaults. Shared deployment is documented in deploy/README.md.
AGENTFORGE_DATA_DIR=.agentforge
AGENTFORGE_AUTH_REQUIRED=false
# AGENTFORGE_ENV=production
# AGENTFORGE_ALLOWED_HOSTS=your-actual-workshop-host,localhost,127.0.0.1
